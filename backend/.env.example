# Copy to .env for local development: cp .env.example .env
# In production, set these in your host's dashboard instead. Never commit .env.

# Gemini API key, needed for the AI features (writing and tidying up recipes).
GEMINI_API_KEY=

# Comma-separated list of websites allowed to call the API from a browser.
# Locally that's the Vite dev server; in production, your frontend's URL.
CORS_ORIGINS=http://localhost:5173

# Optional (defaults shown).
# GEMINI_MODEL=gemini-3.5-flash-lite
# THEMEALDB_API_KEY=1
# AI_DAILY_CAP=20
# AI_PER_IP_LIMIT=5
# TRUSTED_PROXY_HOPS=0
