# Copy to .env.local for local overrides: cp .env.example .env.local
# Vite bakes VITE_* values into the built files, so they are public. Never put secrets here.

# Full URL of the deployed API, e.g. https://recipe-finder-api.example.com
# Leave empty in development: requests go to /api and Vite forwards them to uvicorn on :8000.
VITE_API_BASE_URL=
